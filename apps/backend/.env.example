# ===========================================
# LLM Provider Configuration
# ===========================================
# Supported providers: openai, anthropic, openrouter, gemini, deepseek, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
LLM_API_KEY=your-gemini-key-here
LLM_CONFIG_ENCRYPTION_KEY=replace-with-a-stable-long-random-secret

# For Ollama (local models)
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b
# LLM_API_BASE=http://localhost:11434
#
# IMPORTANT: For Docker deployments with Ollama on host machine:
# Use host.docker.internal instead of localhost:
# LLM_API_BASE=http://host.docker.internal:11434
# (Works on macOS/Windows. On Linux, use your host IP or --network=host)

# For OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=sk-or-v1-your-key

# For Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-your-key

# For Google Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_API_KEY=your-gemini-key

# For DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your-deepseek-key

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_LLM=WARNING

# Frontend URL - Used for PDF generation
FRONTEND_BASE_URL=http://localhost:3000

# Render native deploys should set this to 0 and use the same prefix in the
# build command when installing Playwright Chromium. That keeps the browser
# executable available at runtime for PDF export.
# PLAYWRIGHT_BROWSERS_PATH=0

# PostgreSQL database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/som_career_coach

# Shared secret used to sign frontend-issued backend bearer tokens.
# Must match BACKEND_AUTH_SHARED_SECRET in the frontend environment.
BACKEND_AUTH_SHARED_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_ISSUER=resume-matcher-frontend
AUTH_TOKEN_AUDIENCE=resume-matcher-backend
AUTH_TOKEN_TTL_SECONDS=900

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
